# Copy the required settings into /etc/learning-highschool/ai.env on the server.
# Never commit a populated API key. Restart learning-highschool after editing.
# Production ignores LEARN_AI_STUB; the preview environment may use STUB=1.
LEARN_AI_STUB=0
LEARN_AI_TIMEOUT=45

LEARN_AI_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LEARN_AI_GLM_MODEL=glm-4.7-flash
LEARN_AI_GLM_KEY=

LEARN_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LEARN_AI_DEEPSEEK_MODEL=deepseek-v4-flash
LEARN_AI_DEEPSEEK_KEY=

LEARN_AI_GPT_BASE_URL=https://api.openai.com/v1
LEARN_AI_GPT_MODEL=gpt-4o-mini
LEARN_AI_GPT_KEY=
