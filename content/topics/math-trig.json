      "intro": "三个一错就丢分的记忆陷阱。",
      "myths": [
        {
          "title": "误区一：sin(α+β)=sinα+sinβ",
          "wrong": "正弦对加法可以拆开，直接把两个值相加。",
          "why": "取 α=β=30°，左边 sin60°=√3/2≈0.866，右边 1/2+1/2=1，明显不等。正弦不是线性函数。",
          "right": "sin(α+β) 要用和角公式：sinαcosβ+cosαsinβ。",
          "check": {
            "stem": "取 α=β=30°，sin(α+β) 与 sinα+sinβ 的关系是：",
            "options": [
              "相等",
              "无法比较",
              "前者更大",
              "不相等，前者为 √3/2，后者为 1"
            ],
            "answer": 3,
            "explain": "sin60°=√3/2，而 sin30°+sin30°=1，两者不等。"
          }
        },
        {
          "title": "误区二：判断符号时把 α 当成任意角",
          "wrong": "用 α 本身的象限去判断诱导公式的符号。",
          "why": "口诀里的「符号看象限」，看的是「把 α 视为锐角时，整个角 k·π/2±α 所在象限」，不是 α 的象限。",
          "right": "先把 α 当成锐角，再判断整体角的象限，最后取该象限中函数的符号。",
          "check": {
            "stem": "化简 cos(π+α)（α 为锐角）时，符号应取：",
            "options": [
              "负号，因为 π+α 在第三象限",
              "正号，因为 α 是锐角",
              "负号，因为 α 是锐角",
              "正号，因为 π+α 在第二象限"
            ],
            "answer": 0,
            "explain": "α 是锐角时 π+α 在第三象限，cos 为负，所以 cos(π+α)=−cosα。"
          }
        },
        {
          "title": "误区三：角度与弧度混用",
          "wrong": "把 sin30 当成 sin30°，或者在周期公式里混用角度。",
          "why": "sin30（弧度）≈−0.988，与 sin30°=1/2 完全不同。周期、求导等公式都默认用弧度。",
          "right": "三角函数的分析性质一律用弧度；写角度时务必带「°」。",
          "check": {
            "stem": "下列说法正确的是：",
            "options": [
              "周期公式中角度更方便",
              "sin30（弧度）与 sin30° 一般不相等，分析性质要用弧度",
              "弧度与角度可以随意混用",
              "sin30 与 sin30° 一定相等"
            ],
            "answer": 1,
            "explain": "30 弧度与 30° 是不同的角，数值差异很大；周期、单调性等结论都以弧度制表述。"
          }
        }
      ]
