                "−cosα"
              ],
              "answer": 2,
              "explain": "k=2 偶，名不变；π−α 在第二象限，sin 为正。"
            },
            {
              "ask": "第二步：cos(π+α) 等于：",
              "options": [
                "cosα",
                "sinα",
                "−sinα",
                "−cosα"
              ],
              "answer": 3,
              "explain": "k=2 偶，名不变；π+α 在第三象限，cos 为负。"
            },
            {
              "ask": "第三步：tan(−α) 等于：",
              "options": [
                "−tanα",
                "tanα",
                "−sinα",
                "1/tanα"
              ],
              "answer": 0,
              "explain": "正切是奇函数，tan(−α)=−tanα。"
            },
            {
              "ask": "第四步：原式化简的结果是：",
              "options": [
                "1",
                "sin²α",
                "−sin²α",
                "cos²α"
              ],
              "answer": 1,
              "explain": "原式 = sinα·(−cosα)·(−tanα) = sinα cosα·(sinα/cosα) = sin²α。"
            }
          ],
          "note": "诱导公式化简的固定顺序：先逐个化到 α 的三角函数，再合并；符号用「原角象限」判断。"
        },
